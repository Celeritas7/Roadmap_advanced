# Copy this file to .env.local and fill in values from the Supabase dashboard
# (Project Settings → API).
# NOTE: this app runs single-user with RLS DISABLED, so the anon key is NOT a
# security boundary — anyone with the URL + key can read/write the roadmap_*
# tables. Accepted tradeoff for a personal deployment (see README "Honest notes").
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional dev aid: set to "1" to enable the simulated-hour slider.
# Leave unset in production — the deploy host should not define this.
# VITE_DEBUG_TIME=1
